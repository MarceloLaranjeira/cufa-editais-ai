{
  "name": "cufa-editais-ai-server",
  "version": "2.0.0",
  "description": "Servidor Backend em Node.js/Express/TypeScript para o CUFA Editais AI com suporte a GPT 5.6 e Fable 5, Prisma ORM e integrações governamentais.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:db-push": "prisma db push"
  },
  "keywords": ["cufa", "editais", "ai", "express", "typescript", "prisma", "pncp", "mrosc"],
  "author": "Central Única das Favelas — CUFA",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "archiver": "^6.0.1",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
